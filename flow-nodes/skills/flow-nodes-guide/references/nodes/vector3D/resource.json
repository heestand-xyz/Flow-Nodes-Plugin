    {
      "complexity": "advanced",
      "docs": "Create a 3D vector path from an L-system grammar. Draw forward with F, move forward without drawing with f, use + and - for yaw Z, & and ^ for pitch X, \\ and / for roll Y, and [ ] for branches.",
      "familyName": "3D Vector",
      "inLets": [
        {
          "capacity": "mono",
          "direction": "direct",
          "info": "The initial L-system symbol string.",
          "level": "external",
          "name": "Axiom",
          "typeName": "axiomIn",
          "valueType": "raw:core:string",
          "way": "in"
        },
        {
          "capacity": "mono",
          "direction": "direct",
          "info": "Replacement rules separated by new lines or semicolons.",
          "level": "external",
          "name": "Rules",
          "typeName": "rulesIn",
          "valueType": "raw:core:string",
          "way": "in"
        },
        {
          "capacity": "mono",
          "direction": "direct",
          "info": "The number of times the rules are applied. Warning: this can get heavy fast at higher values.",
          "level": "external",
          "name": "Iterations",
          "typeName": "iterationsIn",
          "valueType": "raw:core:int",
          "way": "in"
        },
        {
          "capacity": "mono",
          "direction": "direct",
          "info": "The starting turtle orientation. Forward is along local Y.",
          "level": "external",
          "name": "Initial Rotation",
          "typeName": "initialRotationIn",
          "valueType": "raw:core:angle3D",
          "way": "in"
        },
        {
          "capacity": "mono",
          "direction": "direct",
          "info": "The turn amount used by +, -, &, ^, \\, and / symbols.",
          "level": "external",
          "name": "Angle",
          "typeName": "angleIn",
          "valueType": "raw:core:angle",
          "way": "in"
        },
        {
          "capacity": "mono",
          "direction": "direct",
          "info": "The distance moved by draw and move symbols.",
          "level": "external",
          "name": "Step Length",
          "typeName": "stepLengthIn",
          "valueType": "raw:core:float",
          "way": "in"
        },
        {
          "capacity": "mono",
          "direction": "direct",
          "info": "Symbols that draw a segment while moving forward.",
          "level": "external",
          "name": "Draw Symbols",
          "typeName": "drawSymbolsIn",
